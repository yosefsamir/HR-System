@{
    ViewData["Title"] = "إعدادات واتساب";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <h2 class="mb-0">
                <i class="bi bi-whatsapp me-2 text-success"></i>إعدادات واتساب
            </h2>
        </div>
    </div>

    <partial name="_SettingsNav" />

    <div id="alertContainer"></div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card bg-dark border-secondary h-100">
                <div class="card-header bg-secondary">
                    <h5 class="mb-0"><i class="bi bi-phone me-2"></i>حالة الاتصال</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <span class="text-muted">الحالة الحالية:</span>
                        <span id="statusBadge" class="badge bg-warning ms-2">جارٍ التحميل...</span>
                    </div>

                    <div class="rounded-3 p-3 mb-3" style="background: linear-gradient(135deg, rgba(25,135,84,0.20), rgba(13,110,253,0.15)); border: 1px solid rgba(255,255,255,0.12);">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-person-badge text-info"></i>
                            <span class="small text-light fw-semibold">بيانات رقم واتساب</span>
                        </div>

                        <div class="row g-2">
                            <div class="col-12">
                                <div class="small text-muted">رقم الهاتف</div>
                                <div id="waPhone" class="fw-semibold text-light">-</div>
                            </div>
                            <div class="col-12">
                                <div class="small text-muted">اسم الحساب</div>
                                <div id="waProfile" class="fw-semibold text-light">-</div>
                            </div>
                            <div class="col-12">
                                <div class="small text-muted">اسم الجلسة</div>
                                <div id="waSession" class="text-light">-</div>
                            </div>
                        </div>
                    </div>

                    <p class="text-muted small">إذا كانت الحالة SCAN_QR_CODE قم بمسح الكود من تطبيق واتساب.</p>

                    <div class="d-grid mt-3">
                        <button type="button" class="btn btn-warning" onclick="fullRelinkSession()">
                            <i class="bi bi-arrow-repeat me-2"></i>إغلاق الجلسة وإظهار QR جديد
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card bg-dark border-secondary h-100">
                <div class="card-header bg-secondary d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-qr-code-scan me-2"></i>QR Code</h5>
                    <small class="text-light">امسح من واتساب > الأجهزة المرتبطة</small>
                </div>
                <div class="card-body d-flex flex-column align-items-center justify-content-center" style="min-height: 340px;">
                    <div id="qrLoading" class="text-center text-muted">
                        <div class="spinner-border text-success mb-2" role="status"></div>
                        <div>جارٍ تحميل QR...</div>
                    </div>
                    <img id="qrImage" alt="OpenWA QR" class="img-fluid rounded border border-light d-none" style="max-height: 320px; background: #fff; padding: 10px;" />
                    <div id="noQr" class="text-center text-muted d-none">
                        <i class="bi bi-qr-code fs-1"></i>
                        <div class="mt-2">لا يوجد QR حالياً. ابدأ الجلسة أو انتظر التحديث.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-12">
            <div class="card bg-dark border-secondary">
                <div class="card-header bg-secondary">
                    <h5 class="mb-0"><i class="bi bi-file-earmark-pdf me-2"></i>اختبار إرسال PDF</h5>
                </div>
                <div class="card-body">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-4">
                            <label for="testPhoneNumber" class="form-label">رقم واتساب</label>
                            <input type="text" id="testPhoneNumber" class="form-control" placeholder="2010xxxxxxxx أو +2010xxxxxxxx" />
                        </div>
                        <div class="col-md-5">
                            <label for="testCaption" class="form-label">تعليق (اختياري)</label>
                            <input type="text" id="testCaption" class="form-control" placeholder="اختبار PDF" />
                        </div>
                        <div class="col-md-3">
                            <button type="button" class="btn btn-danger w-100" onclick="sendTestPdf()">
                                <i class="bi bi-send me-2"></i>إرسال PDF تجريبي
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let isRefreshingConnection = false;

    document.addEventListener('DOMContentLoaded', refreshConnection);

    async function postJson(url, payload = null) {
        const options = { method: 'POST' };
        if (payload) {
            options.headers = { 'Content-Type': 'application/json' };
            options.body = JSON.stringify(payload);
        }

        const response = await fetch(url, options);
        return await response.json();
    }

    async function fullRelinkSession() {
        try {
            const result = await postJson('/Settings/FullRelinkWhatsAppSession');
            showAlert(result.message || 'تم تنفيذ العملية', result.success ? 'success' : 'danger');
            await refreshConnection();
        } catch (error) {
            console.error(error);
            showAlert('حدث خطأ أثناء إعادة الربط', 'danger');
        }
    }

    async function refreshConnection() {
        if (isRefreshingConnection) return;
        isRefreshingConnection = true;
        toggleQrState('loading');

        try {
            const response = await fetch('/Settings/GetWhatsAppConnection');
            const result = await response.json();

            if (!result.success) {
                showAlert('تعذر قراءة حالة واتساب', 'danger');
                toggleQrState('none');
                return;
            }

            updateStatus(result.status || 'UNKNOWN');
            updatePhoneInfo(result.session || {});
            if (result.qrCode) {
                const qrImg = document.getElementById('qrImage');
                qrImg.src = result.qrCode;
                toggleQrState('image');
            } else {
                toggleQrState('none');
            }
        } catch (error) {
            console.error(error);
            showAlert('حدث خطأ أثناء جلب بيانات الاتصال', 'danger');
            toggleQrState('none');
        } finally {
            isRefreshingConnection = false;
        }
    }

    function updatePhoneInfo(session) {
        document.getElementById('waPhone').textContent = session.whatsAppId || '-';
        document.getElementById('waProfile').textContent = session.pushName || '-';
        document.getElementById('waSession').textContent = session.sessionName || '-';
    }

    function updateStatus(status) {
        const badge = document.getElementById('statusBadge');
        badge.textContent = status;

        badge.className = 'badge ms-2';
        if (status === 'WORKING' || status === 'CONNECTED') {
            badge.classList.add('bg-success');
        } else if (status === 'SCAN_QR_CODE' || status === 'STARTING') {
            badge.classList.add('bg-warning', 'text-dark');
        } else {
            badge.classList.add('bg-secondary');
        }
    }

    function toggleQrState(state) {
        document.getElementById('qrLoading').classList.toggle('d-none', state !== 'loading');
        document.getElementById('qrImage').classList.toggle('d-none', state !== 'image');
        document.getElementById('noQr').classList.toggle('d-none', state !== 'none');
    }

    function showAlert(message, type) {
        const alertHtml = `
            <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        `;
        document.getElementById('alertContainer').innerHTML = alertHtml;
    }

    async function sendTestPdf() {
        const phoneNumber = (document.getElementById('testPhoneNumber').value || '').trim();
        const caption = (document.getElementById('testCaption').value || '').trim();

        if (!phoneNumber) {
            showAlert('اكتب رقم واتساب قبل الاختبار', 'warning');
            return;
        }

        try {
            const result = await postJson('/Settings/SendTestPdfWhatsApp', { phoneNumber, caption });
            showAlert(result.message || 'تم تنفيذ العملية', result.success ? 'success' : 'danger');
        } catch (error) {
            console.error(error);
            showAlert('حدث خطأ أثناء إرسال PDF التجريبي', 'danger');
        }
    }
</script>
}
