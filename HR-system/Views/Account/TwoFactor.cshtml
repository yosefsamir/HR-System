@model HR_system.ViewModels.TwoFactorSetupViewModel

@{
    ViewData["Title"] = "المصادقة الثنائية";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-10 col-12">
            <div class="row mb-3">
                <div class="col-12">
                    <h2 class="mb-0">
                        <i class="bi bi-gear-fill me-2 text-primary"></i>الإعدادات
                    </h2>
                    <small class="text-muted">تخصيص النظام وإعدادات الرواتب والأمان</small>
                </div>
            </div>

            <!-- Top Navigation Bar -->
            <partial name="_SettingsNav" />

            <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
                <div>
                    <h5 class="text-white mb-1">إعدادات المصادقة الثنائية</h5>
                    <div class="text-muted">الحساب: <span class="text-white">@Model.UserName</span></div>
                </div>
            </div>

            @if (Model.RecoveryCodes?.Any() == true)
            {
                <div class="alert alert-warning border-0">
                    <div class="d-flex align-items-start">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <div>
                            <div class="fw-bold mb-1">رموز الاسترداد (احفظها في مكان آمن)</div>
                            <div class="small mb-2">هذه الرموز تُعرض مرة واحدة فقط.</div>
                            <div class="row g-2">
                                @foreach (var code in Model.RecoveryCodes)
                                {
                                    <div class="col-md-3 col-6">
                                        <code class="d-block bg-dark text-light p-2 rounded border border-secondary text-center">@code</code>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="card bg-dark border-secondary">
                <div class="card-body">
                    @if (Model.IsEnabled)
                    {
                        <div class="alert alert-success border-0 mb-4">
                            <i class="bi bi-check-circle me-2"></i>
                            المصادقة الثنائية مفعّلة على هذا الحساب.
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <form asp-action="DisableTwoFactor" asp-controller="Account" method="post" class="d-flex flex-wrap gap-2 align-items-end">
                                @Html.AntiForgeryToken()
                                <div>
                                    <label asp-for="Code" class="form-label text-light mb-1">رمز التحقق</label>
                                    <input asp-for="Code" id="disableCode" class="form-control bg-black text-light border-secondary"
                                           placeholder="مثال: 123456 أو رمز استرداد" inputmode="numeric" autocomplete="one-time-code" />
                                </div>
                                <button type="submit" class="btn btn-outline-danger">
                                    <i class="bi bi-shield-x me-1"></i>تعطيل
                                </button>
                            </form>

                            <form asp-action="ResetAuthenticatorKey" asp-controller="Account" method="post" class="d-flex flex-wrap gap-2 align-items-end"
                                  onsubmit="return confirm('سيتم إعادة ضبط مفتاح المصادقة وتعطيل المصادقة الثنائية. هل أنت متأكد؟');">
                                @Html.AntiForgeryToken()
                                <div>
                                    <label asp-for="Code" class="form-label text-light mb-1">رمز التحقق</label>
                                    <input asp-for="Code" id="resetCode" class="form-control bg-black text-light border-secondary"
                                           placeholder="مثال: 123456 أو رمز استرداد" inputmode="numeric" autocomplete="one-time-code" />
                                </div>
                                <button type="submit" class="btn btn-outline-warning">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i>إعادة ضبط المفتاح
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info border-0 mb-4">
                            <i class="bi bi-info-circle me-2"></i>
                            فعّل المصادقة الثنائية لزيادة أمان تسجيل الدخول. ستحتاج تطبيق مصادقة مثل Google Authenticator أو Microsoft Authenticator.
                        </div>

                        <div class="row g-4 align-items-start">
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <div class="fw-bold text-white mb-2">1) امسح رمز QR</div>
                                    @if (!string.IsNullOrWhiteSpace(Model.QrCodeImageDataUrl))
                                    {
                                        <div class="p-3 bg-white rounded" style="display:inline-block">
                                            <img src="@Model.QrCodeImageDataUrl" alt="QR" style="width:220px;height:220px" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted">تعذر إنشاء رمز QR.</div>
                                    }
                                </div>

                                <div class="mb-3">
                                    <div class="fw-bold text-white mb-2">2) أو أدخل المفتاح يدوياً</div>
                                    <code class="d-inline-block bg-black text-light p-2 rounded border border-secondary">@Model.SharedKey</code>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                @if (!ViewData.ModelState.IsValid)
                                {
                                    <div class="alert alert-danger" role="alert">
                                        <i class="bi bi-exclamation-triangle me-2"></i>
                                        @Html.ValidationSummary(true, null, new { @class = "mb-0" })
                                    </div>
                                }

                                <div class="fw-bold text-white mb-2">3) أكّد الرمز</div>
                                <form asp-action="EnableTwoFactor" asp-controller="Account" method="post">
                                    @Html.AntiForgeryToken()
                                    <div class="mb-3">
                                        <label asp-for="Code" class="form-label text-light">رمز التحقق</label>
                                        <input asp-for="Code" class="form-control bg-black text-light border-secondary"
                                               placeholder="مثال: 123456" inputmode="numeric" autocomplete="one-time-code" />
                                        <span asp-validation-for="Code" class="text-danger small"></span>
                                    </div>
                                    <button type="submit" class="btn btn-success">
                                        <i class="bi bi-shield-check me-1"></i>تفعيل المصادقة الثنائية
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
